{
    "name": "sonocchi-monorepo",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "yarn workspace web dev",
        "dev:web": "yarn workspace web dev",
        "dev:game": "yarn workspace game dev",
        "build": "yarn workspace web build && yarn workspace game build",
        "build:web": "yarn workspace web build",
        "build:game": "yarn workspace game build",
        "build:exe": "yarn workspace game build:exe",
        "preview": "yarn workspace web preview",
        "deploy": "yarn build && gh-pages -d dist -m \"Updates --skip-ci\""
    },
    "devDependencies": {
        "gh-pages": "^6.3.0"
    },
    "homepage": "https://ihoseihohuman.github.io/sonocchi"
}
